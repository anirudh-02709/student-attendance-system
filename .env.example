# MongoDB Configuration
# Connection URI for your MongoDB instance or cluster
MONGODB_URI=your-mongodb-connection-string

# Initial Faculty / Administrator Account Credentials
# Used to seed the initial faculty administrator account on first run
INITIAL_FACULTY_USERNAME=admin
INITIAL_FACULTY_PASSWORD=your-initial-password

# JWT Authentication
# Base64-encoded secret key (minimum 256 bits) for HMAC-SHA256 token signing
JWT_SECRET=your-secret
JWT_EXPIRATION_MS=3600000
